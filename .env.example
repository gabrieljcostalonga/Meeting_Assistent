# Porta local do app (abra http://localhost:3000 no Chrome ou Edge)
PORT=3000

# ---------- Acesso ao Claude ----------
# auto = usa a chave da API se existir; senão, o Claude Code CLI logado neste computador
# api  = só a chave da API      cli = só o Claude Code CLI
LLM_MODE=auto
# Chave da API Anthropic (console.anthropic.com). Deixe vazio para usar o Claude Code CLI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Caminho do comando do Claude Code CLI, se não estiver no PATH
CLAUDE_CLI_PATH=claude
# Modelo usado no modo CLI (alias). "sonnet" funciona dentro dos limites do plano Pro.
CLAUDE_CLI_MODEL=sonnet

# ---------- Notion (opcional: OAuth público) ----------
# Sem estes valores, o app pede um token de integração interna (mais simples).
# Redirect URI a cadastrar no Notion: http://localhost:3000/auth/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# ---------- Google Drive (OAuth) ----------
# Redirect URI a cadastrar no Google Cloud: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
